{
  "name": "ecommerce",
  "version": "0.0.0",
  "private": true,
  "description": "Modular monolith eCommerce monorepo. Application code is added in later steps.",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=9.2.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:config": "node scripts/check-tsconfig.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
