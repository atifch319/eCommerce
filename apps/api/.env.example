# HTTP port. 4000 leaves 3000 free for the Next.js app.
PORT=4000

# development, test, or production
NODE_ENV=development

# Browser origin allowed to call this API. Not a wildcard.
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL connection for this API process.
# The local development user has no password because PostgreSQL trusts TCP
# connections from 127.0.0.1. Set a password before using any other host.
DATABASE_URL=postgresql://ecommerce_dev@127.0.0.1:5432/ecommerce_dev?schema=public
